<div class="page plugin_carbon_quick_report">
    <!-- Header with background image -->
    <header class="page-header header-height illustration container-fluid">
      <div class="container-fluid">
        <img src="{{ header_pic_url }}" class="illustration-header" alt="GLPI Carbon header" />
        <h1 class="page-title title-color title-position">{{ __('GLPI Carbon', 'carbon') }}</h1>
      </div>
    </header>
    <style>
      /*  Hide dashboard toolbar to disable edit mode */
      .dashboard-card .toolbar {
        /* display: none; */
      }
    </style>

    {% block body %}
    {{ include('central/messages.html.twig') }}

    {# Ensure carbon.js is loaded (GLPI hooks may not always include it on this page) #}
    <script src="{{ carbon_js_url }}"></script>

    {% if numecoeval_enabled %}
      <div class="container-fluid my-3">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">
              <i class="fas fa-leaf text-success"></i> {{ __('NumEcoEval LCA Calculation', 'carbon') }}
            </h5>
            <p class="text-muted mb-3">{{ __('Lifecycle assessment for peripherals via NumEcoEval. Follow the steps below.', 'carbon') }}</p>

            <div class="d-flex gap-2 align-items-center flex-wrap">
              {# Step 1: Upload inventory #}
              <button id="numecoeval-upload-btn" class="btn btn-primary"
                      onclick="GLPIPlugin.Carbon.uploadInventory('{{ numecoeval_ajax_url }}', '{{ numecoeval_csrf_token }}')">
                <i class="fas fa-upload"></i> {{ __('Step 1: Upload inventory', 'carbon') }}
              </button>

              {# Step 2: Launch calculation (disabled until step 1 OK) #}
              <button id="numecoeval-calcul-btn" class="btn btn-secondary" disabled
                      onclick="GLPIPlugin.Carbon.submitCalcul('{{ numecoeval_ajax_url }}', '{{ numecoeval_csrf_token }}')">
                <i class="fas fa-calculator"></i> {{ __('Step 2: Launch calculation', 'carbon') }}
              </button>
            </div>

            {% if numecoeval_last_lot_name %}
              <div class="mt-3 text-muted small">
                <i class="fas fa-history text-secondary me-1"></i>
                {{ __('Last calculation run:', 'carbon') }}
                <strong>{{ numecoeval_last_calculation_date }}</strong>
                ({{ __('Lot:', 'carbon') }} <code>{{ numecoeval_last_lot_name }}</code>)
              </div>
            {% endif %}

            {# Status message area #}
            <div id="numecoeval-status" class="alert mt-2" style="display:none;"></div>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="page-body">
      {{ dashboard|raw }}
    </div>
    {% endblock %}

  <footer class="container-fluid mt-3 footer-height d-flex justify-content-center">
      <img src="{{ footer_pic_url }}" class="py-1 illustration-footer" alt="GLPI Carbon footer" />
  </footer>
</div>
